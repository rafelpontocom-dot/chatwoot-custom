<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><%= @booking_page.title.presence || @booking_page.account.name %></title>
    <link rel="icon" type="image/svg+xml" href="/brand-assets/raevo-favicon.svg">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png">
    <%= csrf_meta_tags %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'public_booking' %>
  </head>
  <body class="min-h-screen bg-n-surface-2 text-n-slate-12">
    <%= yield %>
  </body>
</html>
