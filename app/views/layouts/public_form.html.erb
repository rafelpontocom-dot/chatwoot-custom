<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Formulário</title>
    <!--
      Logo nova da identidade visual (cartão 123jpnbd8y3). Vem do PNG de 800px
      que o Thiago aprovou: não há versão vetorial, e aproximar uma marca à mão
      é o que o AGENTS.md proíbe. Assim que houver SVG, troca-se aqui.
    -->
    <link rel="icon" type="image/png" sizes="512x512" href="/brand-assets/raevo-favicon-512.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/brand-assets/raevo-favicon-32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/brand-assets/raevo-favicon-16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/brand-assets/raevo-favicon-180.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-icon-180x180.png">
    <%= csrf_meta_tags %>
    <%= vite_client_tag %>
    <%= vite_javascript_tag 'public_form' %>
  </head>
  <body class="min-h-screen bg-n-slate-2 text-n-slate-12">
    <%= yield %>
  </body>
</html>
