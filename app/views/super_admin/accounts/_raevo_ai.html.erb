<% integration = account.raevo_ai_integration %>
<% boards = KanbanBoard.where(account: account).active.ordered.includes(:kanban_stages) %>
<% stages = boards.flat_map { |board| board.kanban_stages.active.ordered.map { |stage| [board, stage] } } %>
<% configured_board = integration&.settings&.dig('crm', 'boards')&.values&.first || {} %>
<% configured_stages = configured_board.fetch('stages', {}) %>

<section class="main-content__body">
  <hr class="my-8 border-n-weak">
  <h2 class="text-xl text-n-slate-12">RAEVO AI</h2>

  <% if integration&.enabled? %>
    <p class="text-sm text-n-teal-11">Active for <%= integration.clinic_id %>.</p>
    <%= form_with scope: :raevo_ai, url: rotate_raevo_ai_command_token_super_admin_account_path(account), method: :post, class: 'form' do |form| %>
      <div class="field-unit">
        <%= form.label :command_token, t('super_admin.raevo_ai.command_token') %>
        <%= form.password_field :command_token, required: true, autocomplete: 'new-password' %>
      </div>
      <div class="field-unit">
        <%= form.check_box :token_deployed %>
        <%= form.label :token_deployed, t('super_admin.raevo_ai.token_deployed_confirmation') %>
      </div>
      <div class="form-actions">
        <%= form.submit t('super_admin.raevo_ai.rotate_command_token') %>
      </div>
    <% end %>
  <% elsif integration.present? && integration.settings['command_token_digest'].present? %>
    <p class="text-sm text-n-amber-11">Provisioned for <%= integration.clinic_id %>. Activate only after the tenant command token is deployed in Volt.</p>
    <h3 class="text-base text-n-slate-12"><%= t('super_admin.raevo_ai.stage_mapping') %></h3>
    <%= form_with scope: :raevo_ai, url: update_raevo_ai_stage_mapping_super_admin_account_path(account), method: :post, class: 'form' do |form| %>
      <%= hidden_field_tag 'raevo_ai[board_key]', integration.settings.dig('crm', 'boards')&.keys&.first %>
      <%= hidden_field_tag 'raevo_ai[board_id]', configured_board['board_id'] %>
      <%= hidden_field_tag 'raevo_ai[initial_stage_id]', configured_board['initial_stage_id'] %>
      <%= render 'semantic_stage_mapping_fields', form: form, stages: stages, configured_stages: configured_stages %>
      <div class="form-actions">
        <%= form.submit t('super_admin.raevo_ai.save_stage_mapping') %>
      </div>
    <% end %>
    <%= form_with url: activate_raevo_ai_super_admin_account_path(account), method: :post, class: 'form' do %>
      <div class="field-unit">
        <%= check_box_tag :token_deployed, '1', false, id: "token_deployed_#{account.id}" %>
        <%= label_tag "token_deployed_#{account.id}", t('super_admin.raevo_ai.token_deployed_confirmation') %>
      </div>
      <div class="form-actions">
        <%= submit_tag 'Activate AI', class: 'button' %>
      </div>
    <% end %>
  <% else %>
    <p class="text-sm text-n-slate-11">Provision the CRM catalog and IA fields. This step keeps the assistant inactive.</p>
    <%= form_with scope: :raevo_ai, url: provision_raevo_ai_super_admin_account_path(account), method: :post, class: 'form' do |form| %>
      <div class="field-unit">
        <%= form.label :clinic_id, 'Clinic ID' %>
        <%= form.text_field :clinic_id, required: true %>
      </div>
      <div class="field-unit">
        <%= form.label :command_token, t('super_admin.raevo_ai.command_token') %>
        <%= form.password_field :command_token, required: true, autocomplete: 'new-password' %>
      </div>
      <div class="field-unit">
        <%= form.label :board_key, 'CRM board key' %>
        <%= form.text_field :board_key, required: true, value: 'acquisition' %>
      </div>
      <div class="field-unit">
        <%= form.label :board_id, 'CRM board' %>
        <%= form.select :board_id, boards.map { |board| [board.name, board.id] }, { include_blank: 'Select a board' }, required: true %>
      </div>
      <div class="field-unit">
        <%= form.label :initial_stage_id, 'Initial stage' %>
        <%= form.select :initial_stage_id, stages.map { |board, stage| ["#{board.name} — #{stage.name}", stage.id] }, { include_blank: 'Select an initial stage' }, required: true %>
      </div>
      <div class="field-unit">
        <h3 class="text-base text-n-slate-12"><%= t('super_admin.raevo_ai.stage_mapping') %></h3>
        <%= render 'semantic_stage_mapping_fields', form: form, stages: stages, configured_stages: configured_stages %>
      </div>
      <div class="form-actions">
        <%= form.submit 'Provision AI' %>
      </div>
    <% end %>
  <% end %>
</section>
